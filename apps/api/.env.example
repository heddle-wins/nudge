# `mock` is deterministic and needs no key; use it for local development and tests.
NUDGE_PROVIDER=mock
NUDGE_MODEL=gpt-5-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
FASTROUTER_BASE_URL=https://api.fastrouter.ai/api/v1
FASTROUTER_API_KEY=
# Comma-separated origins permitted to call this API in deployed environments.
NUDGE_ALLOWED_ORIGINS=chrome-extension://*
